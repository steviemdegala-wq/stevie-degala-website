# Public browser key. Restrict it in Google Cloud to the production domains
# and enable Places API (New).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_restricted_google_key

# Lead capture. CRM and internal email are redundant capture paths; at least
# one must succeed before the calculator reports a successful submission.
CRM_URL=https://crm-two-beta-90.vercel.app
CRM_PASSWORD=your_crm_password
RESEND_API_KEY=re_your_resend_key
LEAD_NOTIFICATION_EMAIL=steviemdegala@gmail.com

# Use a sender on a domain verified in Resend for reliable borrower delivery.
LEAD_FROM_EMAIL=Mortgage Stevie <leads@mortgagestevie.com>
